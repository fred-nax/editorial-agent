# Copier vers .env et renseigner les valeurs réelles.
# Ne jamais committer .env ni le copier dans l’image Docker.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_AGENT_ID=

# --- WordPress (brouillons uniquement) ---
WP_URL=https://naxialis.com
WP_USERNAME=
WP_APP_PASSWORD=

# --- PostgreSQL ---
# Dev local (Next hors Docker) : hôte 127.0.0.1.
# Docker Compose surcharge DATABASE_URL vers l’hôte interne `postgres`.
POSTGRES_USER=naxialis
POSTGRES_PASSWORD=
POSTGRES_DB=naxialis_agent
DATABASE_URL=postgresql://naxialis:password@127.0.0.1:5432/naxialis_agent

# --- Auth.js ---
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://agent.naxialis.com
AUTH_TRUST_HOST=true
ADMIN_EMAIL=
# npm run auth:hash-password -- "votre-mot-de-passe"  → coller la valeur base64
ADMIN_PASSWORD_HASH=

# --- Reverse proxy VPS (jwilder/nginx-proxy) ---
# Nom exact du réseau Docker du proxy (docker network ls / inspect).
# Production : les deux lignes suivantes sont obligatoires.
PROXY_NETWORK=nginx-proxy_default
PROXY_EXTERNAL=true
# Email Let's Encrypt déjà utilisé par le companion, si celui-ci le demande par conteneur.
LETSENCRYPT_EMAIL=

# --- Local Docker uniquement ---
# APP_PORT=3002
