# Copier vers .env et renseigner les valeurs réelles.
# Ne jamais committer .env ni le copier dans l’image Docker.

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_AGENT_ID=
# Agent éditorial Webflow (V7.10.0) — jamais de repli sur OPENAI_AGENT_ID.
# OPENAI_WEBFLOW_AGENT_ID=
# Optionnels V7 (défauts serveur si absents) :
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OPENAI_VISION_MODEL=gpt-4.1-mini
# OPENAI_TITLE_MODEL=gpt-4.1-mini
# OPENAI_SIMILARITY_MODEL=gpt-4.1-mini

# --- WordPress (brouillons uniquement) ---
WP_URL=https://naxialis.com
WP_USERNAME=
WP_APP_PASSWORD=

# --- Webflow Data API V2 (V7.10.0 — lecture / mapping uniquement) ---
# WEBFLOW_API_TOKEN=
# WEBFLOW_SITE_ID=
# WEBFLOW_COLLECTION_ID=

# --- Images à la une V7 (volume Docker Compose) ---
# Compose force déjà FEATURED_IMAGE_STORAGE_DIR=/app/storage/featured-images.
# FEATURED_IMAGE_STORAGE_DIR=

# --- PostgreSQL ---
# Dev local (Next hors Docker) : hôte 127.0.0.1.
# Docker Compose surcharge DATABASE_URL vers l’hôte interne `postgres`.
POSTGRES_USER=naxialis
POSTGRES_PASSWORD=
POSTGRES_DB=naxialis_agent
DATABASE_URL=postgresql://naxialis:password@127.0.0.1:5432/naxialis_agent

# --- Chiffrement AppSettings (OpenAI / WordPress en base) ---
# openssl rand -base64 32
# Distinct de GOOGLE_TOKEN_ENCRYPTION_KEY.
APP_SETTINGS_ENCRYPTION_KEY=

# --- Auth.js ---
# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://agent.naxialis.com
AUTH_TRUST_HOST=true
ADMIN_EMAIL=
# npm run auth:hash-password -- "votre-mot-de-passe"  → coller la valeur base64
ADMIN_PASSWORD_HASH=

# --- Reverse proxy VPS (jwilder/nginx-proxy) ---
# Nom exact du réseau Docker du proxy (docker network ls / inspect).
# Production : les deux lignes suivantes sont obligatoires.
PROXY_NETWORK=nginx-proxy_default
PROXY_EXTERNAL=true
# Email Let's Encrypt déjà utilisé par le companion, si celui-ci le demande par conteneur.
LETSENCRYPT_EMAIL=

# --- Google Search Console & Analytics (optionnel) ---
# Connexion OAuth indépendante de l’auth administrateur Auth.js.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32
# GOOGLE_TOKEN_ENCRYPTION_KEY=
# Secret Bearer pour le cron VPS quotidien (POST /api/google/sync/cron)
# GOOGLE_SYNC_CRON_SECRET=
# URI de redirection à déclarer dans Google Cloud :
#   {AUTH_URL}/api/google/oauth/callback

# --- Local Docker uniquement ---
# APP_PORT=3002
