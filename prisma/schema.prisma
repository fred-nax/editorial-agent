generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GenerationStatus {
  pending
  queued
  running
  completed
  failed
}

enum TopicStatus {
  pending
  generating
  completed
  archived
}

enum OpportunityStatus {
  new
  reviewed
  added_to_queue
  dismissed
}

enum OpportunityContentType {
  news
  evergreen
  commercial
}

/// Qualification de tendance SEO 1.3 (distinct du contentType éditorial).
enum TrendType {
  emerging
  news
  evergreen
  unverified
}

enum TrendConfidence {
  low
  medium
  high
}

enum EditorialUrgency {
  low
  medium
  high
}

enum ResearchMode {
  domains
  free
}

enum ResearchGoal {
  seo
  trends
  problems
  commercial
}

/// Espace éditorial isolé (V7.11) — pas de multi-tenant SaaS.
model EditorialWorkspace {
  id              String   @id
  slug            String   @unique
  name            String
  cmsProvider     String
  siteUrl         String?
  siteLabel       String?
  defaultLanguage String   @default("fr")
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cmsSettings       WorkspaceCmsSettings?
  generations       ArticleGeneration[]
  featuredImages    ArticleFeaturedImage[]
  topics            Topic[]
  watchSearches     EditorialWatchSearch[]
  wordpressPosts    WordPressPost[]
  wordpressSyncRuns WordPressSyncRun[]
  customThemes      CustomTheme[]
  researchConfigs   ResearchConfig[]
  opportunityRuns   OpportunitySearchRun[]
  opportunities     SeoOpportunity[]
  googleSelection   GooglePropertySelection?
  googleSyncRuns    GoogleSyncRun[]
  gscPropertyStats  GscPropertyDailyStat[]
  gscPageStats      GscPageDailyStat[]
  gscQueryStats     GscQueryDailyStat[]
  ga4PageStats      Ga4PageDailyStat[]
  ga4SourceStats    Ga4PageSourceDailyStat[]
  migrationIssues   WorkspaceMigrationIssue[]

  @@index([cmsProvider, enabled])
}

/// Connexion CMS + agent + paramètres SEO propres à un espace.
/// Secrets chiffrés AES-256-GCM (même crypto que AppSettings).
model WorkspaceCmsSettings {
  id                       String   @id @default(cuid())
  workspaceId              String   @unique
  workspace                EditorialWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Agent OpenAI de l’espace (WP ou Webflow selon cmsProvider).
  openaiAgentId            String?
  /// WordPress
  wpUrl                    String?
  wpUsername               String?
  wpAppPasswordEncrypted   String?
  inventoryWpOrigin        String?
  inventoryValid           Boolean  @default(true)
  wpCategoriesJson         String?
  wpAllowedCategoryIds     String?
  wpDefaultCategoryId      Int?
  wpCategoriesSyncedAt     DateTime?
  wpCategoriesOrigin       String?
  wpSeoPlugin              String?
  /// Webflow
  webflowApiTokenEncrypted String?
  webflowSiteId            String?
  webflowCollectionId      String?
  webflowFieldMappingJson  String?
  /// Langue éditoriale (copie du workspace, surcharge éventuelle).
  defaultLanguage          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Ambiguïtés de rattachement détectées pendant la migration V7.11 (pas d’assignation silencieuse).
model WorkspaceMigrationIssue {
  id           String   @id @default(cuid())
  workspaceId  String?
  workspace    EditorialWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  entityType   String
  entityId     String
  reason       String
  details      Json?
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([resolved])
}

model ArticleGeneration {
  id              String             @id @default(cuid())
  workspaceId     String
  workspace       EditorialWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  subject         String
  title           String?
  excerpt         String?
  slug            String?
  status          GenerationStatus
  wpPostId        Int?
  wpUrl           String?
  /// Statut renvoyé par WordPress à la création du brouillon. Null si non enregistré.
  wpStatus        String?
  /// Destination CMS : wordpress (défaut / historique) | webflow (futur). Null = wordpress.
  cmsDestination  String?
  /// Identifiant externe CMS (ex. String(wpPostId) pour WordPress). Null si non publié côté CMS.
  cmsExternalId   String?
  categories      Json?
  metaTitle       String?
  metaDescription String?
  inputTokens       Int?
  cachedInputTokens Int?
  outputTokens      Int?
  reasoningTokens   Int?
  estimatedCost     Float?
  model             String?
  durationMs        Int?
  sessionId         String?
  /// Contexte transmis et événements observés. Null pour les générations antérieures.
  trace             Json?
  /// Indications éditoriales facultatives (angle, public, objectif, mots-clés, notes).
  editorialContext  Json?
  error             String?
  topicId           String?
  progressStage     String?
  progressMessage   String?
  progressUpdatedAt DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  featuredImages ArticleFeaturedImage[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
  @@index([workspaceId, cmsDestination])
}

/// Image à la une (manuelle V7.0 ou demandée avec l’article V7.1).
model ArticleFeaturedImage {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    EditorialWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  generationId String
  generation   ArticleGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  /// Chemin relatif sous le répertoire de stockage (jamais un path absolu client).
  relativePath String
  mimeType     String   @default("image/webp")
  byteSize     Int?
  prompt       String
  style        String
  aspectRatio  String
  size         String
  model        String
  /// Instructions visuelles saisies à la demande (auto ou manuelle).
  visualInstructions String?
  /// auto = demandé avec l’article ; manual = panneau détail.
  origin       String   @default("manual")
  altText      String?
  altModel     String?
  /// pending | generating | ready | failed | uploading | attached
  status       String   @default("ready")
  wpMediaId    Int?
  wpMediaUrl   String?
  error        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([generationId, createdAt])
  @@index([workspaceId, status])
  @@index([status])
  @@index([status, updatedAt])
}

model Topic {
  id        String      @id @default(cuid())
  workspaceId String
  workspace EditorialWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  subject   String
  status    TopicStatus @default(pending)
  priority  Int         @default(0)
  notes     String?
  category  String?
  angle     String?
  /// "veille" pour un sujet issu de la veille. Null pour un sujet manuel ou SEO.
  origin            String?
  sourceUrl         String?
  sourceTitle       String?
  sourceName        String?
  sourcePublishedOn String?
  sourceKind        String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([workspaceId, sourceUrl, subject])
  @@index([workspaceId, status])
  @@index([sourceUrl])
}

/// Recherche de veille réussie. Le JSON contient les publications validées, jamais la réponse OpenAI brute.
model EditorialWatchSearch {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    EditorialWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  theme        String
  periodDays   Int
  country      String
  searchedAt   DateTime @default(now())
  articleCount Int
  results      Json
  status       String   @default("completed")

  @@index([workspaceId, searchedAt])
  @@index([searchedAt])
}

/// Inventaire éditorial WordPress (lecture seule, upsert, jamais de suppression).
model WordPressPost {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   EditorialWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  wpPostId    Int
  title       String
  slug        String
  url         String
  status      String
  /// Type WordPress : "post" | "page" (défaut post pour l’historique).
  contentType String    @default("post")
  excerpt     String?
  contentText String?
  categories  Json?
  publishedAt DateTime?
  modifiedAt  DateTime?
  syncedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, wpPostId])
  @@index([workspaceId, slug])
  @@index([slug])
  @@index([status])
  @@index([contentType])
  @@index([modifiedAt])
}

model WordPressSyncRun {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       EditorialWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  status          String
  mode            String
  fetchedCount    Int       @default(0)
  upsertedCount   Int       @default(0)
  expectedTotal   Int?
  storedCount     Int?
  pagesFetched    Int?
  totalPages      Int?
  statusBreakdown Json?
  diagnosticNote  String?
  error           String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@index([workspaceId, startedAt])
}

/// Catalogue unifié des thématiques SEO (V7.5) — administrable manuellement.
model CustomTheme {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   EditorialWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  description String?
  active      Boolean  @default(true)
  /// Clé logique historique (ex. ai_agents) — seed V7.5, unique si présente.
  legacyKey   String?
  /// Angles éditoriaux (JSON string[]).
  explorationAngles Json?
  /// Quota par défaut pour une recherche multi-thématiques.
  defaultQuota Int     @default(5)
  /// Ordre d’affichage (croissant).
  sortOrder   Int      @default(0)
  /// Services liés éventuels (JSON string[]) — prompts SEO uniquement.
  naxialisServices Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  configs       ResearchConfig[]
  runs          OpportunitySearchRun[]
  opportunities SeoOpportunity[]

  @@unique([workspaceId, legacyKey])
  @@index([workspaceId, active])
  @@index([active])
  @@index([name])
  @@index([sortOrder])
}

/// Configuration de recherche enregistrée (ne mute pas l’historique).
model ResearchConfig {
  id                   String       @id @default(cuid())
  workspaceId          String
  workspace            EditorialWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name                 String
  mode                 ResearchMode
  researchGoal         ResearchGoal @default(seo)
  domains              Json?
  customTopic          String?
  researchInstructions String?
  requestedCount       Int          @default(10)
  customThemeId        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  customTheme CustomTheme?           @relation(fields: [customThemeId], references: [id], onDelete: SetNull)
  runs        OpportunitySearchRun[]

  @@index([workspaceId, mode])
  @@index([mode])
  @@index([customThemeId])
}

model OpportunitySearchRun {
  id                   String        @id @default(cuid())
  workspaceId          String
  workspace            EditorialWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  status               String
  themes               Json?
  mode                 ResearchMode?
  researchGoal         ResearchGoal?
  customTopic          String?
  researchInstructions String?
  requestedCount       Int?
  configSnapshot       Json?
  configId             String?
  customThemeId        String?
  foundCount           Int           @default(0)
  skippedExisting      Int           @default(0)
  rejectedCount        Int           @default(0)
  domainBreakdown      Json?
  error                String?
  startedAt            DateTime      @default(now())
  finishedAt           DateTime?

  config      ResearchConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  customTheme CustomTheme?    @relation(fields: [customThemeId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([status])
  @@index([mode])
  @@index([configId])
  @@index([customThemeId])
  @@index([startedAt])
}

model SeoOpportunity {
  id               String                 @id @default(cuid())
  workspaceId      String
  workspace        EditorialWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  title            String
  subject          String
  angle            String?
  searchIntent     String?
  /// Label dénormalisé (historique + affichage). Conservé en V7.5.
  theme            String
  /// Lien catalogue V7.5 (nullable pour opportunités antérieures).
  themeId          String?
  contentType      OpportunityContentType @default(evergreen)
  rationale        String?
  sources          Json?
  naxialisService  String?
  status           OpportunityStatus      @default(new)
  fingerprint      String?
  scoreTotal       Int
  scoreRelevance   Int
  scoreCommercial  Int
  scoreIntent      Int
  scoreTimeliness  Int
  scoreOriginality Int
  scoreRationale   Json?
  similarPosts     Json?
  similarTopics    Json?
  duplicateRisk    String?
  topicId          String?
  searchRunId      String?
  /// SEO 1.3 — tendance (nullable pour opportunités historiques)
  trendType           TrendType?
  trendScore          Int?
  trendConfidence     TrendConfidence?
  trendJustification  String?
  trendCheckedAt      DateTime?
  editorialUrgency    EditorialUrgency?
  trendSignals        Json?
  trendHistory        Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  themeRef CustomTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, fingerprint])
  @@index([workspaceId, status])
  @@index([status])
  @@index([theme])
  @@index([themeId])
  @@index([contentType])
  @@index([scoreTotal])
  @@index([searchRunId])
  @@index([trendType])
  @@index([editorialUrgency])
}

/// Configuration installation (mono-site). Secrets chiffrés AES-256-GCM.
/// Priorité : valeurs DB > variables d'environnement. Jamais de secret en clair.
/// V7.11 : secrets globaux (clé OpenAI, identité) ; CMS migré vers WorkspaceCmsSettings (dual-read legacy).
model AppSettings {
  id                     String   @id @default("default")
  clientName             String?
  siteName               String?
  openaiAgentId          String?
  openaiApiKeyEncrypted  String?
  wpUrl                  String?
  wpUsername             String?
  wpAppPasswordEncrypted String?
  /// Origin WP ayant peuplé l'inventaire local (anti-contamination inter-sites).
  inventoryWpOrigin      String?
  /// false après changement de site jusqu'à une sync full réussie du nouveau WP.
  inventoryValid         Boolean  @default(true)
  /// Snapshot JSON des catégories WP synchronisées ({id,name,slug,count,description}[]).
  wpCategoriesJson       String?
  /// IDs de catégories autorisées pour la génération (JSON number[]).
  wpAllowedCategoryIds   String?
  /// Catégorie par défaut si aucune correspondance (doit appartenir au snapshot courant).
  wpDefaultCategoryId    Int?
  wpCategoriesSyncedAt   DateTime?
  /// Origin WP du snapshot de catégories (anti-contamination inter-sites).
  wpCategoriesOrigin     String?
  /// Plugin SEO WordPress : slim_seo (défaut) | yoast_seo.
  wpSeoPlugin            String?
  /// Agent OpenAI dédié Webflow (OPENAI_WEBFLOW_AGENT_ID). Jamais de repli WP.
  openaiWebflowAgentId   String?
  /// Token Data API V2 chiffré (WEBFLOW_API_TOKEN).
  webflowApiTokenEncrypted String?
  /// Site Webflow sélectionné (WEBFLOW_SITE_ID).
  webflowSiteId          String?
  /// Collection CMS cible (WEBFLOW_COLLECTION_ID).
  webflowCollectionId    String?
  /// Mapping éditorial → champs collection (JSON).
  webflowFieldMappingJson String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

/// Connexion Google OAuth (mono-site / installation). Jetons chiffrés au repos.
model GoogleConnection {
  id                    String   @id @default("default")
  googleAccountEmail    String?
  googleAccountSub      String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scopes                String
  status                String   @default("connected")
  lastError             String?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt

  selections GooglePropertySelection[]
  syncRuns   GoogleSyncRun[]
}

/// Propriétés GSC + GA4 sélectionnées pour un espace éditorial.
model GooglePropertySelection {
  id                 String   @id @default(cuid())
  workspaceId        String   @unique
  workspace          EditorialWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  connectionId       String
  gscPropertyUrl     String?
  gscPropertyType    String?
  gscPermissionLevel String?
  ga4AccountId       String?
  ga4PropertyId      String?
  ga4PropertyName    String?
  updatedAt          DateTime @updatedAt

  connection GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
}

model GoogleSyncRun {
  id           String    @id @default(cuid())
  workspaceId  String?
  workspace    EditorialWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  connectionId String    @default("default")
  status       String
  mode         String
  gscUpserted  Int       @default(0)
  ga4Upserted  Int       @default(0)
  rangeStart   DateTime? @db.Date
  rangeEnd     DateTime? @db.Date
  error        String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  connection GoogleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startedAt])
  @@index([status])
  @@index([startedAt])
}

/// Totaux Search Console quotidiens au niveau propriété (pas une somme de pages).
model GscPropertyDailyStat {
  id          String   @id @default(cuid())
  workspaceId String?
  workspace   EditorialWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  propertyUrl String
  date        DateTime @db.Date
  clicks      Float    @default(0)
  impressions Float    @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  hasData     Boolean  @default(true)
  syncedAt    DateTime @default(now())

  @@unique([propertyUrl, date])
  @@index([workspaceId, propertyUrl, date])
  @@index([propertyUrl, date])
}

/// Stats Search Console quotidiennes par URL (upsert).
model GscPageDailyStat {
  id          String   @id @default(cuid())
  workspaceId String?
  workspace   EditorialWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  propertyUrl String
  pageUrl     String
  pageUrlNorm String
  date        DateTime @db.Date
  clicks      Float    @default(0)
  impressions Float    @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  hasData     Boolean  @default(true)
  wpPostId    Int?
  syncedAt    DateTime @default(now())

  @@unique([propertyUrl, pageUrlNorm, date])
  @@index([workspaceId, propertyUrl, date])
  @@index([propertyUrl, date])
  @@index([pageUrlNorm])
  @@index([wpPostId])
}

/// Requêtes GSC quotidiennes (top) par page.
model GscQueryDailyStat {
  id          String   @id @default(cuid())
  workspaceId String?
  workspace   EditorialWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  propertyUrl String
  pageUrlNorm String
  query       String
  date        DateTime @db.Date
  clicks      Float    @default(0)
  impressions Float    @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)
  syncedAt    DateTime @default(now())

  @@unique([propertyUrl, pageUrlNorm, query, date])
  @@index([workspaceId, propertyUrl, pageUrlNorm, date])
  @@index([propertyUrl, pageUrlNorm, date])
}

/// Stats GA4 quotidiennes par page.
model Ga4PageDailyStat {
  id              String   @id @default(cuid())
  workspaceId     String?
  workspace       EditorialWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  propertyId      String
  pagePath        String
  pageUrlNorm     String
  date            DateTime @db.Date
  sessions        Int      @default(0)
  totalUsers      Int      @default(0)
  engagedSessions Int      @default(0)
  aiSessions      Int      @default(0)
  wpPostId        Int?
  syncedAt        DateTime @default(now())

  @@unique([propertyId, pageUrlNorm, date])
  @@index([workspaceId, propertyId, date])
  @@index([propertyId, date])
  @@index([pageUrlNorm])
  @@index([wpPostId])
}

/// Répartition des sessions GA4 par source classifiée (quotidien).
model Ga4PageSourceDailyStat {
  id          String   @id @default(cuid())
  workspaceId String?
  workspace   EditorialWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  propertyId  String
  pageUrlNorm String
  date        DateTime @db.Date
  sourceKey   String
  sessions    Int      @default(0)
  syncedAt    DateTime @default(now())

  @@unique([propertyId, pageUrlNorm, date, sourceKey])
  @@index([workspaceId, propertyId, pageUrlNorm, date], map: "Ga4PageSource_ws_prop_path_date_idx")
  @@index([propertyId, pageUrlNorm, date])
}
