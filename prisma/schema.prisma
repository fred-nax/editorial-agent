generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GenerationStatus {
  pending
  queued
  running
  completed
  failed
}

enum TopicStatus {
  pending
  generating
  completed
  archived
}

enum OpportunityStatus {
  new
  reviewed
  added_to_queue
  dismissed
}

enum OpportunityContentType {
  news
  evergreen
  commercial
}

/// Qualification de tendance SEO 1.3 (distinct du contentType éditorial).
enum TrendType {
  emerging
  news
  evergreen
  unverified
}

enum TrendConfidence {
  low
  medium
  high
}

enum EditorialUrgency {
  low
  medium
  high
}

enum ResearchMode {
  domains
  free
}

enum ResearchGoal {
  seo
  trends
  problems
  commercial
}

model ArticleGeneration {
  id              String             @id @default(cuid())
  subject         String
  title           String?
  excerpt         String?
  slug            String?
  status          GenerationStatus
  wpPostId        Int?
  wpUrl           String?
  /// Statut renvoyé par WordPress à la création du brouillon. Null si non enregistré.
  wpStatus        String?
  categories      Json?
  metaTitle       String?
  metaDescription String?
  inputTokens       Int?
  cachedInputTokens Int?
  outputTokens      Int?
  reasoningTokens   Int?
  estimatedCost     Float?
  model             String?
  durationMs        Int?
  sessionId         String?
  /// Contexte transmis et événements observés. Null pour les générations antérieures.
  trace             Json?
  error             String?
  topicId           String?
  progressStage     String?
  progressMessage   String?
  progressUpdatedAt DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Topic {
  id        String      @id @default(cuid())
  subject   String
  status    TopicStatus @default(pending)
  priority  Int         @default(0)
  notes     String?
  category  String?
  angle     String?
  /// "veille" pour un sujet issu de la veille. Null pour un sujet manuel ou SEO.
  origin            String?
  sourceUrl         String?
  sourceTitle       String?
  sourceName        String?
  sourcePublishedOn String?
  sourceKind        String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([sourceUrl, subject])
  @@index([sourceUrl])
}

/// Recherche de veille réussie. Le JSON contient les publications validées, jamais la réponse OpenAI brute.
model EditorialWatchSearch {
  id           String   @id @default(cuid())
  theme        String
  periodDays   Int
  country      String
  searchedAt   DateTime @default(now())
  articleCount Int
  results      Json
  status       String   @default("completed")

  @@index([searchedAt])
}

/// Inventaire éditorial WordPress (lecture seule, upsert, jamais de suppression).
model WordPressPost {
  id          String    @id @default(cuid())
  wpPostId    Int       @unique
  title       String
  slug        String
  url         String
  status      String
  excerpt     String?
  contentText String?
  categories  Json?
  publishedAt DateTime?
  modifiedAt  DateTime?
  syncedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([status])
  @@index([modifiedAt])
}

model WordPressSyncRun {
  id              String    @id @default(cuid())
  status          String
  mode            String
  fetchedCount    Int       @default(0)
  upsertedCount   Int       @default(0)
  expectedTotal   Int?
  storedCount     Int?
  pagesFetched    Int?
  totalPages      Int?
  statusBreakdown Json?
  diagnosticNote  String?
  error           String?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
}

/// Thématique personnalisée (sujet libre enregistré).
model CustomTheme {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  configs ResearchConfig[]
  runs    OpportunitySearchRun[]

  @@index([active])
  @@index([name])
}

/// Configuration de recherche enregistrée (ne mute pas l’historique).
model ResearchConfig {
  id                   String       @id @default(cuid())
  name                 String
  mode                 ResearchMode
  researchGoal         ResearchGoal @default(seo)
  domains              Json?
  customTopic          String?
  researchInstructions String?
  requestedCount       Int          @default(10)
  customThemeId        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  customTheme CustomTheme?           @relation(fields: [customThemeId], references: [id], onDelete: SetNull)
  runs        OpportunitySearchRun[]

  @@index([mode])
  @@index([customThemeId])
}

model OpportunitySearchRun {
  id                   String        @id @default(cuid())
  status               String
  themes               Json?
  mode                 ResearchMode?
  researchGoal         ResearchGoal?
  customTopic          String?
  researchInstructions String?
  requestedCount       Int?
  configSnapshot       Json?
  configId             String?
  customThemeId        String?
  foundCount           Int           @default(0)
  skippedExisting      Int           @default(0)
  rejectedCount        Int           @default(0)
  domainBreakdown      Json?
  error                String?
  startedAt            DateTime      @default(now())
  finishedAt           DateTime?

  config      ResearchConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  customTheme CustomTheme?    @relation(fields: [customThemeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([mode])
  @@index([configId])
  @@index([customThemeId])
  @@index([startedAt])
}

model SeoOpportunity {
  id               String                 @id @default(cuid())
  title            String
  subject          String
  angle            String?
  searchIntent     String?
  theme            String
  contentType      OpportunityContentType @default(evergreen)
  rationale        String?
  sources          Json?
  naxialisService  String?
  status           OpportunityStatus      @default(new)
  fingerprint      String?                @unique
  scoreTotal       Int
  scoreRelevance   Int
  scoreCommercial  Int
  scoreIntent      Int
  scoreTimeliness  Int
  scoreOriginality Int
  scoreRationale   Json?
  similarPosts     Json?
  similarTopics    Json?
  duplicateRisk    String?
  topicId          String?
  searchRunId      String?
  /// SEO 1.3 — tendance (nullable pour opportunités historiques)
  trendType           TrendType?
  trendScore          Int?
  trendConfidence     TrendConfidence?
  trendJustification  String?
  trendCheckedAt      DateTime?
  editorialUrgency    EditorialUrgency?
  trendSignals        Json?
  trendHistory        Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([status])
  @@index([theme])
  @@index([contentType])
  @@index([scoreTotal])
  @@index([searchRunId])
  @@index([trendType])
  @@index([editorialUrgency])
}
